{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SeoPayload",
  "type": "object",
  "definitions": {
    "paginationCanonical": {
      "type": "object",
      "required": ["pageParam", "pageSizeParam", "defaultPageSize", "collectionPath"],
      "properties": {
        "pageParam": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
        "pageSizeParam": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
        "defaultPageSize": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "collectionPath": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*(?:\\.[A-Za-z_$][A-Za-z0-9_$]*)*$" }
      },
      "additionalProperties": false
    },
    "localizedString": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      ]
    },
    "localizedKeywords": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "array",
          "items": { "type": "string" }
        },
        {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "array",
                "items": { "type": "string" }
              }
            ]
          }
        }
      ]
    }
  },
  "required": ["version", "pageId", "domain"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "pageId": { "type": "string" },
    "domain": { "type": "string" },
    "title": { "$ref": "#/definitions/localizedString" },
    "description": { "$ref": "#/definitions/localizedString" },
    "openGraph": { "type": "object", "additionalProperties": true },
    "twitter": { "type": "object", "additionalProperties": true },
    "canonical": { "$ref": "#/definitions/localizedString" },
    "canonicalMode": { "const": "none" },
    "paginationCanonical": { "$ref": "#/definitions/paginationCanonical" },
    "keywords": { "$ref": "#/definitions/localizedKeywords" },
    "robots": { "$ref": "#/definitions/localizedString" }
  },
  "additionalProperties": false
}
